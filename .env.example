# Local Postgres from docker-compose.yml (`pnpm db:up`).
# In Coolify, use the Postgres resource's internal connection URL.
DATABASE_URL=postgres://vocabs:vocabs@localhost:5432/vocabs

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub usernames allowed to sign in. Empty = anyone.
ALLOWED_GITHUB_USERS=

DEEPL_API_KEY=
